+++ b/src/stage/stageController.js
@@ -0,0 +1,120 @@
+// Stage flow for a Blender-built map: the start card, the exit (the facility
+// entrance ends the stage) and the hooks a combat system plugs into. This
+// module only reports where things are and when the player gets there —
+// it runs no combat of its own.
+//
+// Events (game.on):
+//   'stage:start'          (info)            the player pressed start
+//   'stage:combatTrigger'  (combat)          the player first reached combat.trigger
+//   'stage:combatArea'     (inside: bool)    entered / left combat.area
+//   'stage:exitLocked'     ()                reached the exit while it is locked
+//   'stage:exit'           (info)            reached the exit: the stage is over
+//   'stage:combatEnd'      (result)          completeCombat() was called
+// Calls for a combat system:
+//   game.stage.combat        { area: [[x,y]…], anakinStart:[x,y], opponentStart:[x,y], trigger:{center,radius} } (tiles)
+//   game.stage.lockExit(on)  keep the exit shut until the fight is over
+//   game.stage.completeCombat(result)  unlocks the exit and emits 'stage:combatEnd'
+import { dist } from '../core/math.js';
+
+export class StageController {
+  constructor(game, stage) {
+    this.game = game;
+    this.id = stage.id;
+    this.data = stage.data;
+    this.world = stage.world;
+    this.started = false;
+    this.done = false;
+    this.exitLocked = false;
+    this.combatTriggered = false;
+    this.inCombatArea = false;
+    this.lockedHintT = 0;
+    // sprite slices join the prop frame sets (Original now, Remaster when it exists)
+    const A = game.assets;
+    Object.assign(A.propsSD || A.props, this.world.stageFrames.sd);
+    if (A.props !== A.propsSD) Object.assign(A.props, this.world.stageFrames.sd);
+    if (A.propsHD) Object.assign(A.propsHD, this.world.stageFrames.hd);
+  }
+
+  get combat() {
+    return this.data.combat;
+  }
+
+  get exit() {
+    return this.data.exit;
+  }
+
+  info() {
+    return { stage: this.id, name: this.data.name, combat: this.combat, exit: this.exit, time: this.game.time };
+  }
+
+  start() {
+    if (this.started) return;
+    this.started = true;
+    this.game.emit('place', this.data.name);
+    this.game.emit('stage:start', this.info());
+  }
+
+  lockExit(on = true) {
+    this.exitLocked = on;
+  }
+
+  completeCombat(result = {}) {
+    this.exitLocked = false;
+    this.game.emit('stage:combatEnd', result);
+  }
+
+  update(dt) {
+    if (!this.started || this.done) return;
+    const g = this.game;
+    const p = g.player;
+    if (p.dead) return;
+    const c = this.combat;
+    if (c) {
+      if (!this.combatTriggered && dist(p.x, p.y, c.trigger.center[0], c.trigger.center[1]) <= c.trigger.radius) {
+        this.combatTriggered = true;
+        g.emit('stage:combatTrigger', c);
+      }
+      const inside = pointInPoly(p.x, p.y, c.area);
+      if (inside !== this.inCombatArea) {
+        this.inCombatArea = inside;
+        g.emit('stage:combatArea', inside);
+      }
+    }
+    const e = this.exit;
+    this.lockedHintT -= dt;
+    if (p.x >= e.x0 && p.x <= e.x1 && p.y >= e.y0 && p.y <= e.y1) {
+      if (this.exitLocked) {
+        if (this.lockedHintT <= 0) g.emit('stage:exitLocked');
+        this.lockedHintT = 3;
+        return;
+      }
+      this.finish();
+    }
+  }
+
+  /** The player reached the facility entrance: freeze, fade, card, event. */
+  finish() {
+    const g = this.game;
+    const p = g.player;
+    this.done = true;
+    p.path = null;
+    p.action = null;
+    p.scripted = true; // input no longer moves him
+    p.setAnim && p.setAnim('idle');
+    g.emit('fade', 1, 0.9);
+    setTimeout(() => {
+      g.emit('place', '스테이지 종료 · 시설 안으로');
+      g.emit('stage:exit', this.info());
+    }, 950);
+  }
+}
+
+function pointInPoly(x, y, poly) {
+  let inside = false;
+  for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
+    const [xi, yi] = poly[i];
+    const [xj, yj] = poly[j];
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
diff --git a/src/stage/stageWorld.js b/src/stage/stageWorld.js
new file mode 100644
index 0000000..43ed869
--- /dev/null
+++ b/src/stage/stageWorld.js
@@ -0,0 +1,137 @@
+// Stage maps built in Blender (the mustafar-blender repo, v0.4_stage) and
+// exported as data: a pre-rendered backdrop in the game's own projection
+// (30° / 45°, 28.28 px per metre), sprite slices for the few structures a
+// character can walk behind, and a collision mask kept apart from the
+// picture. The world keeps the usual tile grid for the path finder and the
+// map, while unit collision reads the finer mask.
+import { World, BIOME } from '../world/worldgen.js';
+import { PROPS } from '../gfx/models/props.js';
+import { RNG } from '../core/math.js';
+
+const BASE = './stages/';
+let PENDING = null; // World's constructor runs generate() before we could set fields
+
+function loadImage(url) {
+  return new Promise((res, rej) => {
+    const im = new Image();
+    im.onload = () => res(im);
+    im.onerror = () => rej(new Error('스테이지 이미지를 불러오지 못함: ' + url));
+    im.src = url;
+  });
+}
+
+/** Fetch a stage's data and pictures, then build its world. */
+export async function loadStage(id, onProgress = () => {}) {
+  const dir = BASE + id + '/';
+  onProgress(0.05, '스테이지 데이터 불러오는 중…');
+  const data = await (await fetch(dir + 'stage.json')).json();
+  let n = 0;
+  const step = (p) => p.then((v) => (onProgress(0.1 + (++n / 5) * 0.85, '스테이지 이미지 불러오는 중…'), v));
+  const [sd, hd, sprSD, sprHD, col] = await Promise.all(
+    [data.backdrop.sd, data.backdrop.hd, data.sprites.sd, data.sprites.hd, data.collision.file].map((f) => step(loadImage(dir + f))),
+  );
+  const C = data.collision;
+  const c = document.createElement('canvas');
+  c.width = C.cols;
+  c.height = C.rows;
+  const cx = c.getContext('2d', { willReadFrequently: true });
+  cx.drawImage(col, 0, 0);
+  const px = cx.getImageData(0, 0, C.cols, C.rows).data;
+  const mask = new Uint8Array(C.cols * C.rows);
+  for (let i = 0; i < mask.length; i++) mask[i] = px[i * 4] > 127 ? 1 : 0; // 1 = walkable
+  PENDING = { id, data, mask, images: { sd, hd, sprSD, sprHD } };
+  const world = new StageWorld(1);
+  PENDING = null;
+  return { id, data, world };
+}
+
+export class StageWorld extends World {
+  generate() {
+    const S = PENDING;
+    const d = S.data;
+    this.rng = new RNG(1);
+    this.stageId = S.id;
+    this.stage = d;
+    this.col = d.collision;
+    this.fine = S.mask;
+    this.biome.fill(BIOME.LAVA);
+    this.blocked.fill(2);
+    this.explored.fill(1);
+    // the path finder's tiles: walkable when most of the tile is floor
+    const C = this.col;
+    const per = Math.round(1 / C.cell);
+    for (let ty = Math.floor(C.gy0); ty < C.gy0 + C.rows * C.cell; ty++) {
+      for (let tx = Math.floor(C.gx0); tx < C.gx0 + C.cols * C.cell; tx++) {
+        if (!this.inBounds(tx, ty)) continue;
+        let free = 0;
+        for (let j = 0; j < per; j++)
+          for (let i = 0; i < per; i++) if (this.fineFree(tx + (i + 0.5) / per, ty + (j + 0.5) / per)) free++;
+        const k = ty * this.w + tx;
+        if (free) this.biome[k] = BIOME.MUSTAFAR;
+        if (free >= per * per * 0.6) this.blocked[k] = 0;
+      }
+    }
+    // sprite slices (structures a character can pass behind) as props
+    const { sprSD, sprHD } = S.images;
+    this.stageFrames = { sd: {}, hd: {} };
+    for (const p of d.props) {
+      const type = `stage:${S.id}:${p.id}`;
+      // non-enumerable: the prop bakers walk PROPS and must not try to build a stage slice
+      Object.defineProperty(PROPS, type, { value: { rect: p.rect, variants: 1, angles: [0], stage: true }, enumerable: false, configurable: true, writable: true });
+      this.stageFrames.sd[type] = [{ page: sprSD, sx: p.sd.sx, sy: p.sd.sy, w: p.sd.w, h: p.sd.h, ox: p.sd.ox, oy: p.sd.oy }];
+      this.stageFrames.hd[type] = [{ page: sprHD, sx: p.hd.sx, sy: p.hd.sy, w: p.hd.w, h: p.hd.h, ox: p.hd.ox, oy: p.hd.oy, k: 0.5 }];
+      this.addProp(type, p.x, p.y, { noBlock: true, variant: 0, angleIdx: 0 });
+    }
+    this.backdrop = new StageBackdrop(S.images, d.backdrop, this.stageFrames);
+    this.ambient = d.ambient;
+    for (const L of d.lights) this.lights.push({ ...L });
+    this.spawn = { x: d.spawn[0], y: d.spawn[1] };
+    const mid = { x: C.gx0 + (C.cols * C.cell) / 2, y: C.gy0 + (C.rows * C.cell) / 2 };
+    this.pois.push({ ...mid, r: 60, name: d.region || d.name });
+    this.roadSegs = [];
+    this.props.sort((a, b) => a.x + a.y - (b.x + b.y));
+  }
+
+  fineFree(x, y) {
+    const C = this.col;
+    const i = Math.floor((x - C.gx0) / C.cell);
+    const j = Math.floor((y - C.gy0) / C.cell);
+    return i >= 0 && j >= 0 && i < C.cols && j < C.rows && this.fine[j * C.cols + i] === 1;
+  }
+
+  /** Unit collision and line of sight use the fine mask (0.125 m), not the tiles. */
+  isBlocked(x, y) {
+    return !this.fineFree(x, y);
+  }
+}
+
+/** Draws the pre-rendered ground in place of the procedural terrain. */
+class StageBackdrop {
+  constructor(images, b, frames) {
+    this.sd = images.sd;
+    this.hd = images.hd;
+    this.b = b;
+    this.fill = `rgb(${b.fill.join(',')})`;
+    this.frames = frames;
+    this.probe = Object.keys(frames.hd)[0];
+  }
+
+  draw(renderer, ctx, cam, W, H) {
+    // Remaster frames: the HD prop set can be (re)built later; keep ours in it
+    const A = renderer.assets;
+    if (this.probe && A.propsHD && A.propsHD[this.probe] !== this.frames.hd[this.probe]) {
+      Object.assign(A.propsHD, this.frames.hd);
+      if (renderer.hd) renderer.prepareProps();
+    }
+    ctx.fillStyle = this.fill;
+    ctx.fillRect(0, 0, W, H);
+    const b = this.b;
+    if (renderer.hd) {
+      renderer.smooth(true);
+      ctx.drawImage(this.hd, b.x - cam.x, b.y - cam.y, b.w, b.h);
+    } else {
+      renderer.smooth(false);
+      ctx.drawImage(this.sd, Math.round(b.x - cam.x), Math.round(b.y - cam.y));
+    }
+  }
+}
